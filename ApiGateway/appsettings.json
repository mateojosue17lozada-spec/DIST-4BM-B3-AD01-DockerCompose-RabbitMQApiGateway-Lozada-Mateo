{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "PacientesRoute": {
        "ClusterId": "PacientesCluster",
        "Match": {
          "Path": "/api/Pacientes/{**catch-all}"
        }
      },
      "HistorialRoute": {
        "ClusterId": "HistorialCluster",
        "Match": {
          "Path": "/api/Historial/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "PacientesCluster": {
        "Destinations": {
          "pacientesDestination": {
            "Address": "http://pacientes:8080/"
          }
        }
      },
      "HistorialCluster": {
        "Destinations": {
          "historialDestination": {
            "Address": "http://historial:8080/"
          }
        }
      }
    }
  }
}